{
  "name": "@resume-blueprint/core",
  "version": "0.1.0",
  "description": "Pure resume blueprint core: schema, LaTeX sanitization, 9 templates, Tectonic renderer. No UI, no server, no I/O it was not handed.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:update-golden": "UPDATE_GOLDEN=1 node --test test/render.test.ts"
  },
  "dependencies": {
    "common-tags": "^1.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
